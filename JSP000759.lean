theorem validCut_sound (u v : Fin 57) (h : ValidCut u v) :
    ¬ ∃ ps, InternallyDisjointPaths G u v ps := by
  simp [ValidCut, checkData, Bool.and_eq_true, Bool.or_eq_true, List.all_eq_true] at h
  obtain ⟨⟨⟨⟨⟨hu, hv⟩, hur⟩, hvr⟩, size⟩, cross⟩ := h
  apply no_five_of_cut (cutSet u v) (cutSide u v)
  · simpa [cutSet] using hu
  · simpa [cutSet] using hv
  · exact hur
  · simp [cutSide, hvr]
  · intro x y hx hadj hy
    have hc : (((x ∈ (cutData u v).1 ∨ y ∈ (cutData u v).1) ∨
        (cutData u v).2.testBit x.val = (cutData u v).2.testBit y.val) ∨
        x = u ∧ y = v) ∨ y = u ∧ x = v := by
      rcases hadj with hadj | hadj
      · exact cross x y hadj
      · have ht := cross y x hadj
        tauto
    rcases hc with (((hs | hs) | hr) | he) | he
    · exact Or.inl (by simpa [cutSet] using hs)
    · exact Or.inr (Or.inl (by simpa [cutSet] using hs))
    · exact (hy (hr.symm.trans hx)).elim
    · exact Or.inr (Or.inr he)
    · exact (hy (he.1.symm ▸ hur)).elim
  · have hc : (cutSet u v).card ≤ (cutData u v).1.length := List.toFinset_card_le _
    change (cutSet u v).card + (if (u, v) ∈ edges ∨ (v, u) ∈ edges then 1 else 0) ≤ 4
    omega

/-- Every unordered pair has a kernel-checked separating cut. -/
theorem all_cuts_valid (u v : Fin 57) (h : u < v) : ValidCut u v := by
  change u.val < v.val at h
  fin_cases u <;> dsimp only at h
  · by_cases hv : v.val < 29
    · exact cut_valid_0_0 v h (Nat.zero_le _) hv
    · exact cut_valid_0_29 v h (by omega) v.isLt
  · by_cases hv : v.val < 29
    · exact cut_valid_1_0 v h (Nat.zero_le _) hv
    · exact cut_valid_1_29 v h (by omega) v.isLt
  · by_cases hv : v.val < 29
    · exact cut_valid_2_0 v h (Nat.zero_le _) hv
    · exact cut_valid_2_29 v h (by omega) v.isLt
  · by_cases hv : v.val < 29
    · exact cut_valid_3_0 v h (Nat.zero_le _) hv
    · exact cut_valid_3_29 v h (by omega) v.isLt
  · by_cases hv : v.val < 29
    · exact cut_valid_4_0 v h (Nat.zero_le _) hv
    · exact cut_valid_4_29 v h (by omega) v.isLt
  · by_cases hv : v.val < 29
    · exact cut_valid_5_0 v h (Nat.zero_le _) hv
    · exact cut_valid_5_29 v h (by omega) v.isLt
  · by_cases hv : v.val < 29
    · exact cut_valid_6_0 v h (Nat.zero_le _) hv
    · exact cut_valid_6_29 v h (by omega) v.isLt
  · by_cases hv : v.val < 29
    · exact cut_valid_7_0 v h (Nat.zero_le _) hv
    · exact cut_valid_7_29 v h (by omega) v.isLt
  · by_cases hv : v.val < 29
    · exact cut_valid_8_0 v h (Nat.zero_le _) hv
    · exact cut_valid_8_29 v h (by omega) v.isLt
