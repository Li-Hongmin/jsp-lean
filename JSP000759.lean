private theorem no_loops : ∀ x : Fin 57, (x, x) ∉ edges := by decide

/-- Leonard's graph after deletion of the central edge `ab`. -/
def G : SimpleGraph (Fin 57) where
  Adj x y := (x, y) ∈ edges ∨ (y, x) ∈ edges
  symm := ⟨by intro x y h; exact h.symm⟩
  loopless := ⟨by intro x h; exact h.elim (no_loops x) (no_loops x)⟩

instance : DecidableRel G.Adj := fun _ _ => inferInstanceAs
  (Decidable ((_ , _) ∈ edges ∨ (_, _) ∈ edges))

@[simp] theorem G_adj (x y : Fin 57) :
    G.Adj x y ↔ (x, y) ∈ edges ∨ (y, x) ∈ edges := Iff.rfl

theorem G_edgeFinset : G.edgeFinset =
    (edges.map (fun e => s(e.1, e.2))).toFinset := by
  ext e
  induction e using Sym2.ind with
  | _ x y =>
    simp only [SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet, G_adj,
      List.mem_toFinset, List.mem_map]
    constructor
    · rintro (h | h)
      · exact ⟨(x,y), h, rfl⟩
      · exact ⟨(y,x), h, Sym2.eq_swap⟩
    · rintro ⟨⟨a,b⟩, h, he⟩
      rcases Sym2.eq_iff.mp he with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
      · exact Or.inl h
      · exact Or.inr h

theorem G_edge_count : G.edgeFinset.card = 141 := by
  rw [G_edgeFinset]
  decide

#print axioms G_edge_count

end JSP000759


namespace JSP000759
open SimpleGraph

variable {V : Type*} [DecidableEq V] {G : SimpleGraph V} {u v : V}

/-- Five distinct simple paths whose supports intersect only at their endpoints.
Injectivity excludes counting the direct edge more than once. -/
def InternallyDisjointPaths (G : SimpleGraph V) (u v : V)
    (ps : Fin 5 → G.Walk u v) : Prop :=
  Function.Injective ps ∧ (∀ i, (ps i).IsPath) ∧
    ∀ i j, i ≠ j → ∀ x, x ∈ (ps i).support → x ∈ (ps j).support →
      x ≠ u → x ≠ v → False

omit [DecidableEq V] in
lemma walk_stays_in_cut (S : Finset V) (R : V → Prop)
    (cross : ∀ x y, R x → G.Adj x y → ¬ R y →
      x ∈ S ∨ y ∈ S ∨ (x = u ∧ y = v))
    {x y : V} (p : G.Walk x y) (hx : R x)
    (hu : u ∉ p.support) (hS : ∀ z ∈ p.support, z ∉ S) : R y := by
  induction p with
  | nil => exact hx
  | @cons x z y h p ih =>
    have hz : R z := by
      by_contra hz
      rcases cross x z hx h hz with hs | hs | ⟨rfl, _⟩
      · exact hS x (by simp) hs
      · exact hS z (by simp) hs
      · exact hu (by simp)
    exact ih hz (fun hm => hu (by simp [hm])) (fun w hw => hS w (by simp [hw]))

omit [DecidableEq V] in
lemma path_avoiding_cut_is_edge (S : Finset V) (R : V → Prop)
    (huR : R u) (hvR : ¬ R v)
    (cross : ∀ x y, R x → G.Adj x y → ¬ R y →
      x ∈ S ∨ y ∈ S ∨ (x = u ∧ y = v))
    (p : G.Walk u v) (hp : p.IsPath)
    (hS : ∀ z ∈ p.support, z ∉ S) : ∃ h : G.Adj u v, p = h.toWalk := by
  cases p with
  | nil => exact (hvR huR).elim
  | @cons u w v h p =>
    have hp' := (SimpleGraph.Walk.cons_isPath_iff h p).mp hp
    have hw : ¬ R w := by
      intro hw
      exact hvR (walk_stays_in_cut S R cross p hw hp'.2
        (fun z hz => hS z (by simp [hz])))
    have hwv : w = v := by
      rcases cross u w huR h hw with hs | hs | ⟨_, h⟩
      · exact (hS u (by simp) hs).elim
      · exact (hS w (by simp) hs).elim
      · exact h
    subst w
    have hn : p = .nil := (SimpleGraph.Walk.isPath_iff_nil.mp hp'.1).eq_nil
    subst p
    exact ⟨h, rfl⟩

/-- A checked cut gives one slot per separator vertex and, when present, one
additional slot for the direct edge. Distinct internally disjoint paths use
distinct slots, so four slots cannot accommodate five paths. -/
lemma no_five_of_cut [DecidableRel G.Adj] (S : Finset V) (R : V → Prop)
    (huS : u ∉ S) (hvS : v ∉ S) (huR : R u) (hvR : ¬ R v)
    (cross : ∀ x y, R x → G.Adj x y → ¬ R y →
      x ∈ S ∨ y ∈ S ∨ (x = u ∧ y = v))
    (size : S.card + (if G.Adj u v then 1 else 0) ≤ 4) :
    ¬ ∃ ps, InternallyDisjointPaths G u v ps := by
  classical
  rintro ⟨ps, hinj, hpath, hdisj⟩
  have slots : ∀ i : Fin 5, ∃ q : Option V, match q with
      | some z => z ∈ S ∧ z ∈ (ps i).support
      | none => ∃ h : G.Adj u v, ps i = h.toWalk := by
    intro i
    by_cases hex : ∃ z ∈ (ps i).support, z ∈ S
    · obtain ⟨z, hz, hs⟩ := hex
      exact ⟨some z, hs, hz⟩
    · exact ⟨none, path_avoiding_cut_is_edge S R huR hvR cross (ps i) (hpath i)
        (by simpa using hex)⟩
  choose f hf using slots
  have fi : Function.Injective f := by
    intro i j hij
    have hi := hf i
    have hj := hf j
    rw [← hij] at hj
    cases hq : f i with
    | none =>
      rw [hq] at hi hj
      obtain ⟨hiadj, hi⟩ := hi
      obtain ⟨hjadj, hj⟩ := hj
      exact hinj (hi.trans hj.symm)
    | some z =>
      rw [hq] at hi hj
      by_contra hne
      exact hdisj i j hne z hi.2 hj.2
        (fun hz => huS (hz ▸ hi.1)) (fun hz => hvS (hz ▸ hi.1))
  let T : Finset (Option V) := S.image some ∪ (if G.Adj u v then {none} else ∅)
  have fmem : ∀ i, f i ∈ T := by
    intro i
    have hi := hf i
    cases hq : f i with
    | none =>
      rw [hq] at hi
      obtain ⟨hadj, _⟩ := hi
      simp [T, hadj]
    | some z =>
      rw [hq] at hi
      exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨z, hi.1, rfl⟩)
  have hcard : 5 ≤ T.card := by
    have h := Finset.card_le_card_of_injOn f
      (show Set.MapsTo f (Finset.univ : Finset (Fin 5)) T from fun i _ => fmem i)
      (fi.injOn)
    simpa using h
  have ht : T.card ≤ S.card + (if G.Adj u v then 1 else 0) := by
    have h := Finset.card_union_le (S.image some)
      (if G.Adj u v then {none} else ∅ : Finset (Option V))
    have hs : (S.image some).card ≤ S.card := Finset.card_image_le
    dsimp [T]
    split_ifs at * <;> simp_all
  omega

omit [DecidableEq V] in
lemma InternallyDisjointPaths.reverse {ps : Fin 5 → G.Walk u v}
    (h : InternallyDisjointPaths G u v ps) :
    InternallyDisjointPaths G v u (fun i => (ps i).reverse) := by
  refine ⟨SimpleGraph.Walk.reverse_injective.comp h.1, fun i => (h.2.1 i).reverse, ?_⟩
  intro i j hij x hi hj hxv hxu
  exact h.2.2 i j hij x (by simpa using hi) (by simpa using hj) hxu hxv

/-- A closed set containing u and excluding v proves that every u-v walk
meets the separator. The finite certificate checker establishes this closure. -/
lemma walk_meets_separator (S : Finset V) (R : V → Prop)
    (hu : R u) (hv : ¬ R v)
    (closed : ∀ x y, R x → G.Adj x y → ¬ R y → x ∈ S ∨ y ∈ S)
    (p : G.Walk u v) : ∃ z ∈ p.support, z ∈ S := by
  by_contra hn
  have avoid : ∀ z ∈ p.support, z ∉ S := by simpa using hn
  have stays : ∀ {x y} (q : G.Walk x y), R x →
      (∀ z ∈ q.support, z ∉ S) → R y := by
    intro x y q
    induction q with
    | nil => exact fun hx _ => hx
    | @cons x z y e q ih =>
      intro hx ha
      have hz : R z := by
        by_contra hz
        rcases closed x z hx e hz with hs | hs
        · exact ha x (by simp) hs
        · exact ha z (by simp) hs
      exact ih hz (fun t ht => ha t (by simp [ht]))
  exact hv (stays p hu avoid)

/-- Non-reachability in the graph induced outside S forces every original
walk to meet S. This makes explicit the separator/induced-graph equivalence. -/
lemma nonreachable_induce_meets {V : Type*} {G : SimpleGraph V} {u v : V}
    (S : Finset V) (hu : u ∉ S) (hv : v ∉ S)
    (h : ¬ (G.induce {x | x ∉ S}).Reachable ⟨u, hu⟩ ⟨v, hv⟩)
    (p : G.Walk u v) : ∃ z ∈ p.support, z ∈ S := by
  by_contra hn
  have avoid : ∀ z ∈ p.support, z ∉ S := by simpa using hn
  exact h ⟨p.induce {x | x ∉ S} avoid⟩

#print axioms no_five_of_cut
end JSP000759


