/-- Leonard's graph contains no five distinct internally vertex-disjoint paths
between any two distinct vertices. -/
theorem G_no_five (u v : Fin 57) (hne : u ≠ v) :
    ¬ ∃ ps, InternallyDisjointPaths G u v ps := by
  rcases lt_or_gt_of_ne hne with h | h
  · exact validCut_sound u v (all_cuts_valid u v h)
  · rintro ⟨ps, hp⟩
    exact validCut_sound v u (all_cuts_valid v u h) ⟨_, hp.reverse⟩

theorem edge_count_any (i : Fintype G.edgeSet) :
    (@SimpleGraph.edgeFinset (Fin 57) G i).card = 141 := by
  have he : @SimpleGraph.edgeFinset (Fin 57) G i =
      (edges.map (fun e => s(e.1, e.2))).toFinset := by
    ext e
    induction e using Sym2.ind with
    | _ x y =>
      simp only [SimpleGraph.mem_edgeFinset, SimpleGraph.mem_edgeSet, G_adj,
        List.mem_toFinset, List.mem_map]
      constructor
      · rintro (h | h)
        · exact ⟨(x,y), h, rfl⟩
        · exact ⟨(y,x), h, Sym2.eq_swap⟩
      · rintro ⟨⟨a,b⟩, h, he⟩
        rcases Sym2.eq_iff.mp he with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
        · exact Or.inl h
        · exact Or.inr h
  rw [he]
  have h := G_edge_count
  rw [G_edgeFinset] at h
  exact h

open scoped Classical in
/-- Erdős #915 has a counterexample for m = 5, n = 14. -/
theorem leonard_counterexample :
    ∃ H : SimpleGraph (Fin 57),
      H.edgeFinset.card = 141 ∧
      ∀ u v, u ≠ v → ¬ ∃ ps, InternallyDisjointPaths H u v ps := by
  exact ⟨G, edge_count_any _, G_no_five⟩

#print axioms G_no_five
#print axioms leonard_counterexample
