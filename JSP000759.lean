def cutSet (u v : Fin 57) : Finset (Fin 57) := (cutData u v).1.toFinset
def cutSide (u v x : Fin 57) : Prop := (cutData u v).2.testBit x.val = true
instance (u v x : Fin 57) : Decidable (cutSide u v x) := inferInstanceAs (Decidable (_ = true))

def checkData (u v : Fin 57) (d : List (Fin 57) × Nat) : Bool :=
  let s := d.1
  let r := d.2
  !(s.contains u) && !(s.contains v) &&
  r.testBit u.val && !(r.testBit v.val) &&
  decide (s.length + (if G.Adj u v then 1 else 0) ≤ 4) &&
  edges.all (fun e => s.contains e.1 || s.contains e.2 ||
    (r.testBit e.1.val == r.testBit e.2.val) ||
    (e.1 == u && e.2 == v) || (e.2 == u && e.1 == v))

def ValidCut (u v : Fin 57) : Prop := checkData u v (cutData u v) = true
instance (u v : Fin 57) : Decidable (ValidCut u v) :=
  inferInstanceAs (Decidable (_ = true))

